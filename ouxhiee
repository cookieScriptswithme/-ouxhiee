local function applyFog()
	local atmos = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmos then atmos.Density = 0 end

	if FogConfig.Enabled then
		Lighting.FogColor = FogConfig.Color
		Lighting.FogStart = FogConfig.StartDistance
		Lighting.FogEnd = FogConfig.EndDistance
	else
		Lighting.FogStart = 0
		Lighting.FogEnd = 100000
	end
end

local function parseHex(hex)
	hex = hex:gsub("#","")
	if #hex == 6 then
		local r = tonumber(hex:sub(1,2), 16)
		local g = tonumber(hex:sub(3,4), 16)
		local b = tonumber(hex:sub(5,6), 16)
		if r and g and b then return Color3.fromRGB(r, g, b) end
	end
	return nil
end

local function updateChams(character, enable)
	if not character then return end
	local highlight = character:FindFirstChild("CCHubHighlight")
	if enable and HitboxConfig.ChamsEnabled then
		if not highlight then
			highlight = Instance.new("Highlight")
			highlight.Name = "CCHubHighlight"
			highlight.Adornee = character
			highlight.FillColor = HitboxConfig.ChamsColor
			highlight.OutlineColor = HitboxConfig.ChamsColor
			highlight.FillTransparency = 0.5
			highlight.OutlineTransparency = 0
			highlight.Parent = character
		end
		highlight.Enabled = true
	else
		if highlight then highlight.Enabled = false end
	end
end

RunService.RenderStepped:Connect(function()
	pcall(function()
		if FogConfig.Enabled then
			Lighting.FogColor = FogConfig.Color
			Lighting.FogStart = FogConfig.StartDistance
			Lighting.FogEnd = FogConfig.EndDistance
		end

		for _, v in ipairs(Players:GetPlayers()) do
			if v ~= localPlayer and v.Character then
				local char = v.Character
				local hrp = char:FindFirstChild("HumanoidRootPart")
				local humanoid = char:FindFirstChildOfClass("Humanoid")
				
				if hrp and humanoid and humanoid.Health > 0 then
					if HitboxConfig.Enabled then
						if not originalSizes[char] then
							originalSizes[char] = hrp.Size
						end
						hrp.Size = Vector3.new(HitboxConfig.Size, HitboxConfig.Size, HitboxConfig.Size)
						hrp.Transparency = HitboxConfig.Transparency
						hrp.Material = Enum.Material.ForceField
						hrp.CanCollide = false
