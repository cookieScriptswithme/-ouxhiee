						if originalSizes[char] and hrp.Size ~= originalSizes[char] then
							hrp.Size = originalSizes[char]
							hrp.Transparency = 1
							hrp.CanCollide = true
						end
					end
					updateChams(char, HitboxConfig.ChamsEnabled)
				end
			end
		end
	end)
end)

